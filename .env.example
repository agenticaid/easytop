# Variable names only. Copy to .env and fill in; never commit .env.
ANTHROPIC_API_KEY=
# A separate key for the prod environment (read only by tools/ops/create_secrets.sh)
ANTHROPIC_API_KEY_PROD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
# Cloud bots, one per environment (stored with tools/ops/set_bot_token.sh; TELEGRAM_BOT_TOKEN above is the Mac bot)
TELEGRAM_BOT_TOKEN_CLOUD_DEV=
TELEGRAM_BOT_TOKEN_CLOUD_PROD=
# EasyTop-Dev database, read by runs on the Mac (Cloud Run gets SUPABASE_URL from Secret Manager); _PROD names are for create_secrets.sh only
SUPABASE_URL_DEV=
SUPABASE_SERVICE_KEY_DEV=
SESSION_ENCRYPTION_KEY=
# Legacy prototypes / spike tools only
WEBTOP_USERNAME=
WEBTOP_PASSWORD=
# Optional
EASYTOP_LOG_FILE=
EASYTOP_CONNECT_URL=
